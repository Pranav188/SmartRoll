FASTAPI_DATABASE_URL=postgresql+psycopg://smartroll_fastapi:replace-with-a-local-password@fastapi_db:5432/smartroll_fastapi
FASTAPI_REDIS_URL=redis://fastapi_redis:6379/0
FASTAPI_POSTGRES_DB=smartroll_fastapi
FASTAPI_POSTGRES_USER=smartroll_fastapi
FASTAPI_POSTGRES_PASSWORD=replace-with-a-local-password
FASTAPI_STORAGE_ROOT=/var/lib/smartroll
FASTAPI_ALLOWED_ORIGINS=["http://127.0.0.1:8001","http://localhost:8001"]
FASTAPI_ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
FASTAPI_CSRF_SECRET=replace-with-a-long-random-local-secret
FASTAPI_ENROLLMENT_MAX_BYTES=10485760
FASTAPI_CLASSROOM_MAX_BYTES=20971520
FASTAPI_COMPLETED_JOB_RETENTION_HOURS=24
